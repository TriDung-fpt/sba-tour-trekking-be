# =============================================================================
# App Server Configuration
# =============================================================================
SERVER_PORT=8088

# =============================================================================
# PostgreSQL Container & Database Connection Variables
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trekking_db
POSTGRES_PORT=5432

DB_HOST=localhost
DB_PORT=5432
DB_NAME=trekking_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# =============================================================================
# AI / RAG Feature Variables (Compatible with ngrok / LM Studio / Ollama / OpenAI)
# =============================================================================
# If hosting AI on a remote machine via ngrok:
# 1. On AI host machine: run `ngrok http 1234` (or your LM Studio port)
# 2. Set AI_BASE_URL to the ngrok public URL with `/v1` suffix:
#    AI_BASE_URL=https://your-subdomain.ngrok-free.app/v1
# 3. Anyone who clones the repo only needs to update AI_BASE_URL (and DB credentials)!
#
# Defaults to local LM Studio if not specified:
AI_BASE_URL=http://localhost:1234/v1
AI_API_KEY=lm-studio

# Model identifiers loaded on the host machine
AI_CHAT_MODEL=qwen2.5-7b-instruct-1m
AI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
AI_EMBEDDING_DIMENSIONS=768
