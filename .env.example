#This is example credentials. Set up your own. I cant share mine otherwise I will be homeless

# PostgreSQL Container Environment Variables
POSTGRES_USER=your_amazing_accout
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=trekking_db
POSTGRES_PORT=5432

# Spring Boot Database Connection Environment Variables
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trekking_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password

# =============================================================================
# AI / RAG Feature Variables (branch: AI-Features)
# =============================================================================
# OpenAI API key – used ONLY for embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-your-openai-api-key

# LM Studio – local chat model endpoint
LM_STUDIO_BASE_URL=http://localhost:1234
# Must match the model identifier shown in LM Studio's model list
LM_STUDIO_MODEL=lmstudio-community/Meta-Llama-3-8B-Instruct-GGUF
