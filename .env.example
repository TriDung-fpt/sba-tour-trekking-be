# Copy to .env and set local credentials. Do not commit .env.
# Full setup and Apidog variables: docs/api/testing/ENV_SETUP_VI.md
# Host port published by Docker Compose (Apidog baseUrl uses this port).
BACKEND_PORT=8080

# PostgreSQL Container Environment Variables
POSTGRES_USER=your_amazing_accout
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=trekking_db
POSTGRES_PORT=5432

# Spring Boot Database Connection Environment Variables
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trekking_db
DB_USERNAME=your_amazing_accout
DB_PASSWORD=your_secure_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
AUTH_REDIS_PREFIX=trekking:auth:

# Generate two different random secrets, each at least 32 UTF-8 bytes.
JWT_SECRET=
OTP_SECRET=
# Only false for local HTTP. Use true with HTTPS outside local development.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated Google OAuth client IDs accepted by POST /api/v1/auth/google.
# Empty disables Google sign-in; use client IDs for your own frontend applications.
GOOGLE_CLIENT_IDS=

# Private durable storage. Compose uses its dedicated volume at /app/company-licenses.
COMPANY_LICENSE_DIRECTORY=data/company-licenses

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Set explicitly to an address your SMTP account may send from (usually MAIL_USERNAME).
# A present-but-empty MAIL_FROM overrides the application's username fallback.
MAIL_FROM=
FRONTEND_URL=http://localhost:5173

# Optional Cloudinary image storage for partner tour galleries.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional PayOS merchant keys. Payment links and webhook verification stay disabled until all are set.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=http://localhost:5173/booking/payment-result
PAYOS_CANCEL_URL=http://localhost:5173/booking/payment-result
