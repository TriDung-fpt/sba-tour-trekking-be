# Copy to .env and set local credentials. Do not commit .env.
# Full setup and Apidog variables: docs/api/testing/ENV_SETUP_VI.md
# Host port published by Docker Compose (Apidog baseUrl uses this port).
BACKEND_PORT=8080

# PostgreSQL Container Environment Variables
POSTGRES_USER=your_amazing_accout
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=trekking_db
POSTGRES_PORT=5432

# Spring Boot Database Connection Environment Variables
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trekking_db
DB_USERNAME=your_amazing_accout
DB_PASSWORD=your_secure_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
AUTH_REDIS_PREFIX=trekking:auth:

# Generate two different random secrets, each at least 32 UTF-8 bytes.
JWT_SECRET=
OTP_SECRET=
# Only false for local HTTP. Use true with HTTPS outside local development.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=
# Comma-separated Google OAuth client IDs accepted by POST /api/v1/auth/google.
# Empty disables Google sign-in; use client IDs for your own frontend applications.
GOOGLE_CLIENT_IDS=

# payOS channel credentials and frontend redirect URLs
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/payment/result
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel
PAYOS_API_BASE_URL=https://api-merchant.payos.vn
# Booking code prefix used when a tour has no tour code (letters/digits, max 20).
BOOKING_CODE_PREFIX=BK
# Optional PayOS payout (chi ho) channel; leave empty to refund by manual bank transfer only.
PAYOS_PAYOUT_CLIENT_ID=
PAYOS_PAYOUT_API_KEY=
PAYOS_PAYOUT_CHECKSUM_KEY=
# Required for refunds: Base64 of 32 random bytes, e.g. `openssl rand -base64 32`. Never commit a real key.
REFUND_DATA_ENCRYPTION_KEY=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Set explicitly to an address your SMTP account may send from (usually MAIL_USERNAME).
# A present-but-empty MAIL_FROM overrides the application's username fallback.
MAIL_FROM=

# Cloudinary credentials stay on the backend. Empty values disable image upload/delete.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Swagger UI and /v3/api-docs. Set false in production.
API_DOCS_ENABLED=true

# pgAdmin UI published by Docker Compose at http://localhost:5050
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Local LM Studio OpenAI-compatible endpoint for AI/RAG
AI_BASE_URL=http://localhost:1234
AI_API_KEY=lm-studio
AI_CHAT_MODEL=qwen2.5-7b-instruct-1m
AI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
AI_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.1

# Existing databases only: set true temporarily after verifying the current
# schema version, start the backend once, then set it back to false.
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=25
